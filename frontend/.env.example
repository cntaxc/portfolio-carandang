# Copy to .env.local (never commit it).
# Web3Forms access key for the Contact form, created for
# carandangchristianra@gmail.com at https://web3forms.com/.
# Create React App embeds it at build time, so rebuild after changing it.
REACT_APP_WEB3FORMS_ACCESS_KEY=

# AI assistant (server-side only - never prefix with REACT_APP_).
# Used by the local dev server for /api/chat; on Vercel, add it as a *Secret*
# environment variable instead. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
